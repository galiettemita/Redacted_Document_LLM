FROM ghcr.io/astral-sh/uv:0.12.21 AS uv

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    HF_HOME="/opt/huggingface"

RUN groupadd --system app && useradd --system --gid app --home-dir /app app

WORKDIR /app

COPY --from=uv /uv /uvx /bin/
COPY --chown=app:app backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --group retrieval --no-install-project

COPY --chown=app:app backend/src ./src
COPY --chown=app:app backend/corpus ./corpus
COPY --chown=app:app backend/prompts ./prompts
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --group retrieval
RUN python -c "from redacted_backend.retrieval.dense import BgeEncoder; assert BgeEncoder().encode_query('worker readiness probe').shape == (768,)"

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

RUN mkdir -p /artifacts/corpus && chown -R app:app /artifacts /opt/huggingface

USER app

CMD ["dramatiq", "redacted_backend.jobs.tasks", "--processes", "1", "--threads", "1"]
